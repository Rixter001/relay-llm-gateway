# Copy to .env (`cp .env.example .env`) and change the passwords. Never commit .env.

# --- Local stack (docker compose) -----------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
GRAFANA_DB_PASSWORD=change-me-grafana-reader
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# Local model served by Ollama (pulled by `make up`).
OLLAMA_MODEL=llama3.2:3b

# --- Cloud providers (optional) --------------------------------------------------------------
# Leave empty to run with Ollama only. A provider without a key is simply not used.
RELAY_ANTHROPIC_API_KEY=
RELAY_GEMINI_API_KEY=

# --- Relay settings (defaults shown) ---------------------------------------------------------
# RELAY_DEFAULT_POLICY=cost
# RELAY_ANTHROPIC_MODEL=claude-opus-5-5
# RELAY_GEMINI_MODEL=gemini-2.5-flash
# RELAY_PROVIDER_TIMEOUT_S=60
# RELAY_MASKING_SCORE_THRESHOLD=0.35
